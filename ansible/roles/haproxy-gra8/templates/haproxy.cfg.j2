global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	stats socket /run/haproxy/admin.sock mode 660 level admin
	stats timeout 30s
	setenv ACCOUNT_THUMBPRINT '{{ haproxy_acme_thumbprint }}'
	user haproxy
	group haproxy
	daemon

	ca-base /etc/ssl/certs
	crt-base /etc/ssl/private

	ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
	ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
	ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000
	timeout client  50000
	timeout server  50000
	errorfile 400 /etc/haproxy/errors/400.http
	errorfile 403 /etc/haproxy/errors/403.http
	errorfile 408 /etc/haproxy/errors/408.http
	errorfile 500 /etc/haproxy/errors/500.http
	errorfile 502 /etc/haproxy/errors/502.http
	errorfile 503 /etc/haproxy/errors/503.http
	errorfile 504 /etc/haproxy/errors/504.http
	option forwardfor

# ---------------------------------------------------------------------------
# Wireguard passthrough
# ---------------------------------------------------------------------------
frontend wg_front
   mode tcp
   option tcplog
   bind *:51820
   default_backend wg_back

backend wg_back
   mode tcp
   server truenas {{ truenas_ip }}:80

# ---------------------------------------------------------------------------
# HTTP (port 80)
# ---------------------------------------------------------------------------
frontend http_front
   bind *:80

{% for vhost in haproxy_http_vhosts %}
   acl ACL_{{ vhost.name }} hdr(host) -i {{ vhost.domains | join(' ') }}
   use_backend {{ vhost.backend }} if ACL_{{ vhost.name }}
{% endfor %}

   acl ACL_xavifortes hdr(host) -i {{ xavifortes_domain }} www.{{ xavifortes_domain }}
   use_backend xavifortes_mad1_http if ACL_xavifortes
   default_backend http_back

backend http_back
   server npm {{ npm_backend_ip }}:80

{% for backend in haproxy_http_backends %}
backend {{ backend.name }}
   server {{ backend.server_name }} {{ backend.ip }}:{{ backend.port }}

{% endfor %}

# ---------------------------------------------------------------------------
# HTTPS (port 443) — Two-tier SNI routing
#
# Tier 1: TCP SNI pre-router — peeks at SNI before TLS termination
#   xavifortes.com/www → TCP passthrough to MAD1 (Traefik holds LE cert)
#   everything else    → local SSL termination on 127.0.0.1:4443
#
# Tier 2: https_front — SSL termination for legacy domains
#   bound on 127.0.0.1:4443 with PROXY protocol (accept-proxy)
# ---------------------------------------------------------------------------
frontend https_sni_router
   mode tcp
   option tcplog
   bind *:443

   tcp-request inspect-delay 5s
   tcp-request content accept if { req_ssl_hello_type 1 }

   acl is_xavifortes     req_ssl_sni -i {{ xavifortes_domain }}
   acl is_www_xavifortes req_ssl_sni -i www.{{ xavifortes_domain }}
   use_backend xavifortes_mad1_tcp if is_xavifortes
   use_backend xavifortes_mad1_tcp if is_www_xavifortes

   default_backend https_ssl_termination

backend https_ssl_termination
   mode tcp
   server loopback 127.0.0.1:4443 send-proxy-v2

frontend https_front
   bind 127.0.0.1:4443 ssl crt {{ haproxy_certs_path }}/ strict-sni accept-proxy
   mode http

{% for vhost in haproxy_https_vhosts %}
   acl ACL_{{ vhost.name }} hdr(host) -i {{ vhost.domains | join(' ') }}
   use_backend {{ vhost.backend }} if ACL_{{ vhost.name }}
{% endfor %}
   acl acme path_beg /.well-known/acme-challenge/
   use_backend acme_backend if acme
   default_backend https_back

backend https_back
   mode http
   option httpchk
   server npm {{ npm_backend_ip }}:443 ssl verify none

backend acme_backend
   mode http
   server acme 127.0.0.1:{{ acme_backend_port }}

{% for backend in haproxy_https_backends %}
backend {{ backend.name }}
   mode http
   server {{ backend.server_name }} {{ backend.ip }}:{{ backend.port }}{{ ' check-ssl verify none' if backend.ssl | default(false) else '' }}

{% endfor %}

# ---------------------------------------------------------------------------
# xavifortes.com backends (MAD1 Kubernetes cluster)
# ---------------------------------------------------------------------------
backend xavifortes_mad1_tcp
   mode tcp
   option ssl-hello-chk
   balance roundrobin
{% for node in xavifortes_mad1_nodes %}
   server {{ node.name }} {{ node.ip }}:443 check inter 10s rise 2 fall 3
{% endfor %}

backend xavifortes_mad1_http
   mode http
   option forwardfor
   balance roundrobin
{% for node in xavifortes_mad1_nodes %}
   server {{ node.name }} {{ node.ip }}:80 check inter 10s rise 2 fall 3
{% endfor %}

# ---------------------------------------------------------------------------
# Game servers
# ---------------------------------------------------------------------------
frontend gms_front
   mode tcp
   option tcplog
   bind *:25565
   default_backend gms_back

backend gms_back
   mode tcp
   server gms {{ gms_ip }}:25565 check

frontend gmsuhc_front
   mode tcp
   option tcplog
   bind *:25566
   default_backend gmsuhc_back

backend gmsuhc_back
   mode tcp
   server gms {{ gmsuhc_ip }}:25565 check

frontend yuzu_front
   mode tcp
   option tcplog
   bind *:24872
   default_backend yuzu_back

backend yuzu_back
   mode tcp
   server yuzu {{ yuzu_ip }}:24872

# ---------------------------------------------------------------------------
# Kubernetes API
# ---------------------------------------------------------------------------
frontend kubeadm-deb-almond-frontend
   bind *:6443
   mode tcp
   option tcplog
   default_backend kubeadm-deb-almond-backend

backend kubeadm-deb-almond-backend
   mode tcp
   option tcp-check
   server kubeadm-deb-almond-master {{ k8s_kd_ip }}:6443 check
