---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection("research", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);

// Totals across every published post.
const sampleCount = posts.reduce((n, p) => n + p.data.samples.length, 0);
const iocCount = posts.reduce((n, p) => n + p.data.iocs.length, 0);

/*
 * Community submissions.
 *
 * Add the permalink to `href` once each submission clears review — abuse.ch
 * queues manual approval, so the public URL doesn't exist immediately.
 */
const submissions = [
  {
    platform: "MalwareBazaar",
    what: "7 samples from the RenPy/MSBuild loader chain, linked into a dropped_by / dropping chain",
    date: "2026-08",
    href: "https://bazaar.abuse.ch/user/42942/",
  },
  {
    platform: "ThreatFox",
    what: "21 indicators — 15 downloader C2 domains, the stage-1 install tracker, and 5 sample hashes — all approved",
    date: "2026-08",
    href: "https://threatfox.abuse.ch/user/78708/",
  },
  {
    platform: "YARAify",
    what: "6 detection rules covering the carrier project, launcher script, dropper and both loader stages",
    date: "2026-08",
    href: "https://yaraify.abuse.ch/user/51750/",
  },
  {
    platform: "Microsoft Security Intelligence",
    what: "Full chain submitted for Defender coverage, with a note not to signature the clean Ren'Py launcher",
    date: "2026-08",
    href: null,
  },
];
---

<Base
  title="Research — Xavi Fortes"
  description="Malware analysis and reverse engineering notes. Static analysis writeups, extraction tooling, and indicators shared back to the community."
  ogImage="/og-research.png"
>
  <Nav />

  <main class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <header class="mb-16">
        <p class="section-label mb-3">~/research</p>
        <h1
          class="text-3xl md:text-5xl font-semibold text-white tracking-tight mb-5"
        >
          Malware analysis &amp; <span class="gradient-text">reverse engineering</span>
        </h1>
        <p class="text-slate-400 text-lg leading-relaxed max-w-2xl">
          Writeups from pulling apart real samples. Everything here is static analysis
          unless stated otherwise. Samples are linked to public repositories rather
          than hosted here, and indicators on this site are defanged.
        </p>

        <div class="flex flex-wrap items-center gap-3 mt-7">
          <a href="/research/rss.xml" class="btn-ghost text-xs font-mono">rss</a>
          <a href="/research/iocs.json" class="btn-ghost text-xs font-mono">iocs.json</a>
          <a
            href="https://github.com/xavifortes"
            rel="noopener"
            class="btn-ghost text-xs font-mono">tooling</a
          >
        </div>
      </header>

      {
        posts.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-16">
            {[
              ["writeups", posts.length],
              ["samples analysed", sampleCount],
              ["indicators published", iocCount],
              ["submissions", submissions.length],
            ].map(([label, n]) => (
              <div class="card !p-4">
                <p class="font-mono text-2xl text-brand-bright">{n}</p>
                <p class="text-xs text-slate-500 mt-1">{label}</p>
              </div>
            ))}
          </div>
        )
      }

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            {tags.map(([t, n]) => (
              <a
                href={`/research/tags/${t}`}
                class="font-mono text-xs text-slate-400 border border-white/10 rounded-full px-3 py-1 hover:border-brand/50 hover:text-white transition-colors"
              >
                {t} <span class="text-slate-600">{n}</span>
              </a>
            ))}
          </div>
        )
      }

      {
        posts.length === 0 && (
          <div class="card text-slate-500 text-sm">
            Nothing published yet. Drafts are visible in <code class="code-badge">astro dev</code>.
          </div>
        )
      }

      <div class="space-y-3">
        {
          posts.map((p) => (
            <a href={`/research/${p.id}`} class="card block group !p-6">
              <div class="flex flex-col md:flex-row md:items-baseline md:gap-6">
                <time
                  datetime={p.data.pubDate.toISOString().slice(0, 10)}
                  class="font-mono text-xs text-slate-500 shrink-0 md:w-28 mb-2 md:mb-0"
                >
                  {fmt(p.data.pubDate)}
                </time>
                <div class="min-w-0">
                  <h2 class="text-white font-medium group-hover:text-brand-bright transition-colors">
                    {p.data.title}
                    {p.data.draft && (
                      <span class="ml-2 font-mono text-[10px] uppercase tracking-widest text-accent-orange border border-accent-orange/30 rounded px-1.5 py-0.5">
                        draft
                      </span>
                    )}
                  </h2>
                  <p class="text-sm text-slate-400 mt-1.5 leading-relaxed">
                    {p.data.description}
                  </p>
                  {p.data.malwareFamily && (
                    <p class="mt-3">
                      <span class="code-badge">{p.data.malwareFamily}</span>
                    </p>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <section class="mt-20">
        <p class="section-label mb-3">community submissions</p>
        <h2 class="text-xl font-semibold text-white mb-3 tracking-tight">
          Shared back
        </h2>
        <p class="text-sm text-slate-400 mb-8 max-w-2xl leading-relaxed">
          Indicators and samples go to the public trackers so detection vendors and
          other researchers can act on them, not just sit in a writeup.
        </p>

        <div class="space-y-3">
          {
            submissions.map((s) => (
              <div class="card !p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1.5">
                  <p class="font-mono text-sm text-white">
                    {s.href ? (
                      <a
                        href={s.href}
                        rel="noopener"
                        class="text-brand-bright hover:text-accent-green transition-colors"
                      >
                        {s.platform}
                      </a>
                    ) : (
                      s.platform
                    )}
                  </p>
                  <span class="font-mono text-xs text-slate-600">{s.date}</span>
                </div>
                <p class="text-sm text-slate-400 leading-relaxed">{s.what}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Base>
