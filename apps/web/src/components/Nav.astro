---
const navItems = [
  { href: "/", label: "home" },
  { href: "/architecture", label: "architecture" },
  { href: "/cloud", label: "cloud" },
  { href: "/software", label: "software" },
  { href: "/hardware", label: "hardware" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-md bg-surface-0/80"
>
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="font-mono text-sm font-semibold text-white hover:text-brand-bright transition-colors"
    >
      <span class="text-brand">~/</span>xavifortes
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link",
              currentPath === item.href && "!text-brand-bright",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/xavifortes"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-white transition-colors"
        aria-label="GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
      </a>
      <a
        href="mailto:xavifortes@xavifortes.com"
        class="btn-primary hidden sm:inline-flex items-center gap-2"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        hire me
      </a>
    </div>
  </div>
</header>
