---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** "website" for pages, "article" for research posts. */
  ogType?: string;
  /** ISO date — emitted as article:published_time when ogType is "article". */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "Xavier Fortes — Senior DevSecOps Engineer & Cloud Architect",
  description = "Specializing in secure, scalable infrastructure, cloud migrations, and full-stack automation. k3s, Kubernetes, Terraform, ArgoCD, and more.",
  ogImage = "/og-default.png",
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Xavier Fortes" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && <meta property="article:author" content="Xavier Fortes" />}
    <meta property="og:site_name" content="xavifortes.com" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Feed autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Xavier Fortes — Research"
      href={new URL("research/rss.xml", Astro.site)}
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-surface-0">
    <slot />
  </body>
</html>
